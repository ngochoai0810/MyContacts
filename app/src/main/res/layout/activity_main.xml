<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/root" android:orientation="vertical" android:background="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="24dp" android:paddingTop="24dp" android:paddingBottom="16dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Danh bạ" android:textSize="30sp" android:textColor="#202124" android:textStyle="bold" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="36dp" android:text="Cá nhân" android:textSize="13sp" android:textColor="#202124" android:gravity="center" android:background="@drawable/bg_soft" android:paddingHorizontal="14dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginHorizontal="24dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_soft" android:paddingStart="12dp" android:paddingEnd="4dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_search" />
            <EditText android:layout_width="0dp" android:layout_height="52dp" android:id="@+id/search" android:layout_weight="1" android:hint="Tìm tên hoặc số điện thoại" android:textSize="15sp" android:background="@null" android:paddingHorizontal="8dp" android:singleLine="true" android:inputType="text" android:imeOptions="actionDone" />
            <ImageButton android:id="@+id/clearSearch" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_clear" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="14dp" android:contentDescription="Xóa nội dung tìm kiếm" android:visibility="gone" />
        </LinearLayout>
        <ImageButton android:id="@+id/filter" android:layout_width="48dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:src="@drawable/ic_filter" android:background="@drawable/bg_soft" android:padding="12dp" android:contentDescription="Lọc liên hệ" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="24dp" android:layout_marginTop="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/count" android:text="LIÊN HỆ" android:textSize="12sp" android:textColor="#202124" android:textStyle="bold" android:layout_weight="1" android:paddingVertical="8dp" />
        <TextView android:id="@+id/filterLabel" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:text="Tất cả" android:textSize="13sp" android:textColor="#1A73E8" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="4dp" android:background="?android:attr/selectableItemBackground" android:contentDescription="Bộ lọc đang chọn. Nhấn để thay đổi" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/list" android:divider="@null" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="96dp" android:scrollbars="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/empty" android:text="Không tìm thấy liên hệ" android:textSize="16sp" android:textColor="#6B7280" android:gravity="center" android:visibility="gone" android:paddingHorizontal="24dp" android:lineSpacingExtra="6dp" />
        <ImageButton android:layout_width="60dp" android:layout_height="60dp" android:id="@+id/add" android:layout_gravity="bottom|end" android:layout_margin="24dp" android:src="@drawable/ic_add" android:background="@drawable/bg_primary" android:padding="18dp" android:contentDescription="Thêm liên hệ" />
    </FrameLayout>
</LinearLayout>